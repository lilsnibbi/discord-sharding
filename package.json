{
	"name": "@lilsnibbi/discord-sharding",
	"version": "0.1.4",
	"author": "lilsnibbi",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lilsnibbi/discord-sharding.git"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/bun": "1.3.14",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"discord.js": "^14.27.0"
	},
	"peerDependenciesMeta": {
		"discord.js": {
			"optional": true
		}
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"bun": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./package.json": "./package.json"
	},
	"$schema": "https://json.schemastore.org/package.json",
	"bugs": {
		"url": "https://github.com/lilsnibbi/discord-sharding/issues"
	},
	"description": "Bun-native Discord shard orchestration across Hub, Bridge, and shard processes.",
	"engines": {
		"bun": ">=1.3.14"
	},
	"files": [
		"src",
		"migrations",
		"examples",
		"docs",
		"README.md",
		"SECURITY.md",
		"LICENSE"
	],
	"homepage": "https://github.com/lilsnibbi/discord-sharding#readme",
	"keywords": [
		"bun",
		"discord",
		"ipc",
		"sharding",
		"websocket"
	],
	"license": "Apache-2.0",
	"packageManager": "bun@1.3.14",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"check": "bun scripts/check.ts",
		"check:docs": "bun scripts/check-docs.ts",
		"check:examples": "bun scripts/check-examples.ts",
		"check:imports": "bun scripts/check-imports.ts",
		"check:jsdoc": "bun scripts/check-jsdoc.ts",
		"check:lines": "bun scripts/check-lines.ts",
		"check:fix": "biome check --write .",
		"clean": "bun scripts/clean.ts",
		"db:check": "bun scripts/database.ts check",
		"db:migrate": "bun scripts/database.ts migrate",
		"db:new": "bun scripts/database.ts new",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"pack:check": "bun scripts/check-packages.ts",
		"release:pack": "bun scripts/release.ts pack",
		"release:verify": "bun scripts/release.ts verify",
		"test": "bun test --path-ignore-patterns 'tests/performance/**'",
		"test:coverage": "bun scripts/coverage.ts",
		"test:performance": "bun test tests/performance",
		"test:sqlite": "bun test tests/integration/sqlite.test.ts",
		"typecheck": "bunx --bun --no-install tsc --project tsconfig.json --noEmit",
		"verify": "bun scripts/verify.ts"
	},
	"sideEffects": false,
	"type": "module",
	"types": "./src/index.ts",
	"dependencies": {
		"arktype": "2.2.3"
	}
}
